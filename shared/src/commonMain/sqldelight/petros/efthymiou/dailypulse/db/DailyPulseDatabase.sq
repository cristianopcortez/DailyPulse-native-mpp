CREATE TABLE Article (
    title TEXT NOT NULL,
    desc TEXT,
    date TEXT NOT NULL,
    imageUrl TEXT
);

insertArticle:
INSERT INTO Article(title, desc, date, imageUrl)
VALUES(?, ?, ?, ?);

selectAllArticles:
SELECT Article.*
FROM Article;

removeAllArticles:
DELETE FROM Article;

CREATE TABLE Source (
    id TEXT NOT NULL,
    name TEXT NOT NULL,
    desc TEXT NOT NULL,
    origin TEXT NOT NULL
);

insertSource:
INSERT INTO Source(id, name, desc, origin)
VALUES(?, ?, ?, ?);

selectAllSources:
SELECT Source.*
FROM Source;

removeAllSources:
DELETE FROM Source;

CREATE TABLE AggregatorSetting (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    selectedAggregatorId TEXT NOT NULL,
    CHECK (id = 1)
);

insertOrReplaceAggregatorSetting:
INSERT OR REPLACE INTO AggregatorSetting(id, selectedAggregatorId)
VALUES(1, ?);

selectAggregatorSetting:
SELECT AggregatorSetting.*
FROM AggregatorSetting
WHERE id = 1;
